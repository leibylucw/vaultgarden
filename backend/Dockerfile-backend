FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
	curl \
	unzip \
	ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

ARG RCLONE_VERSION=v1.68.2

RUN curl -fsSL -o /tmp/rclone.zip \
	https://downloads.rclone.org/${RCLONE_VERSION}/rclone-${RCLONE_VERSION}-linux-amd64.zip \
	&& unzip /tmp/rclone.zip -d /tmp \
	&& install /tmp/rclone-*/rclone /usr/local/bin/rclone \
	&& rm -rf /tmp/rclone*

RUN pip install --no-cache-dir flask requests

COPY backend.py /app/backend.py
COPY email_templates /app/email_templates

ENV PYTHONUNBUFFERED=1
ENV FLASK_APP=/app/backend.py

ENTRYPOINT ["flask", "run"]
CMD ["--debug", "--host=0.0.0.0", "--port=5000"]
